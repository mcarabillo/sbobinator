# =============================================================================
# SBOBINATOR - Configuration Environment
# =============================================================================
#
# Naming convention:
#   - Flat fields: SBO_<FIELD_NAME>
#   - Nested fields: SBO_<FIELD_NAME>__<SUB_FIELD>
#     Example: SBO_WHISPER_INFERENCE__BEAM_SIZE → settings.whisper_inference.beam_size
#
# Instructions:
#   1. Copy this file to .env.local (or your actual .env file)
#   2. Replace the placeholder values with your own configuration
#   3. Never commit the actual .env file to version control
#
# =============================================================================

# ---------------------------------------------------------------------------
# FastAPI Service
# ---------------------------------------------------------------------------

# Host address the server will bind to
SBO_HOST=0.0.0.0

# Port the server will listen on
SBO_PORT=8000

# Enable debug mode (enables reload, detailed error pages, etc.)
SBO_DEBUG=False

# CORS allowed origins (JSON array of strings)
SBO_CORS__ORIGINS=["http://localhost", "http://localhost:3000"]

# ---------------------------------------------------------------------------
# Inference Mode
# ---------------------------------------------------------------------------
# TODO: Add support for inference mode (local or managed)
# Local = run Whisper model locally; Managed = use remote inference service
SBO_INFERENCE_MODE=[]

# ---------------------------------------------------------------------------
# Faster-Whisper - Model Configuration
# ---------------------------------------------------------------------------

# Whisper model size: tiny, base, small, medium, large-v1, large-v2, large-v3, etc.
SBO_WHISPER_MODEL_SIZE=large-v3

# Custom path to a local Whisper model (overrides SBO_WHISPER_MODEL_SIZE if set)
SBO_WHISPER_MODEL_PATH=

# Language code for speech recognition (e.g., it, en, fr, de)
SBO_WHISPER_LANGUAGE=it

# Task: transcribe (audio to text) or translate (audio to English text)
SBO_WHISPER_TASK=transcribe

# ---------------------------------------------------------------------------
# Faster-Whisper - GPU Configuration
# ---------------------------------------------------------------------------

# Device to run inference on: cuda (GPU) or cpu
SBO_WHISPER_DEVICE=cuda

# GPU device index when using CUDA (0 for first GPU, 1 for second, etc.)
SBO_WHISPER_DEVICE_INDEX=0

# Compute type for quantization: float16, int8, int8_float16, int8_float32, etc.
SBO_WHISPER_COMPUTE_TYPE=int8

# ---------------------------------------------------------------------------
# Faster-Whisper - Inference Parameters
#   → settings.whisper_inference.beam_size
# ---------------------------------------------------------------------------

# Beam search size (higher = more accurate but slower)
SBO_WHISPER_INFERENCE__BEAM_SIZE=5

# Patience for beam search (higher = more aggressive search)
SBO_WHISPER_INFERENCE__PATIENCE=1.0

# Temperature for sampling (0.0 = deterministic, higher = more random)
SBO_WHISPER_INFERENCE__TEMPERATURE=0.0

# Enable BatchedInferencePipeline (batched processing for better throughput)
SBO_WHISPER_INFERENCE__BIP=True

# Batch size (only used when SBO_WHISPER_INFERENCE__BIP is True)
SBO_WHISPER_INFERENCE__BATCH_SIZE=8

# Number of workers (only used when SBO_WHISPER_INFERENCE__BIP is False)
SBO_WHISPER_INFERENCE__NUM_WORKERS=3

# ---------------------------------------------------------------------------
# Faster-Whisper - Text Generation Constraints
#   → settings.whisper_constraints.repetition_penalty
# ---------------------------------------------------------------------------

# Repetition penalty (1.0 = no penalty, >1.0 = penalize repeated tokens)
SBO_WHISPER_CONSTRAINTS__REPETITION_PENALTY=1.0

# Maximum output length ratio relative to input duration
SBO_WHISPER_CONSTRAINTS__LENGTH_RATIO=2.5

# Silence threshold for SPM (Silent Phone Model) token detection
SBO_WHISPER_CONSTRAINTS__SPM_SILENCE_THRESHOLD=0.01

# Silence threshold for WER (Word Error Rate) based detection
SBO_WHISPER_CONSTRAINTS__WER_SILENCE_THRESHOLD=0.5

# Hotwords for forced transcription (JSON array of strings)
SBO_WHISPER_CONSTRAINTS__HOTWORDS=[]

# Token IDs to ban from output (JSON array of integers)
SBO_WHISPER_CONSTRAINTS__BAN_TOKEN_IDS=[]

# Token IDs allowed for punctuation (JSON array of integers, empty = default)
SBO_WHISPER_CONSTRAINTS__ALLOW_PUNCTUATION_TOKENS=[]

# ---------------------------------------------------------------------------
# Faster-Whisper - Voice Activity Detection
#   → settings.whisper_vad.enabled
# ---------------------------------------------------------------------------

# Enable voice activity detection (filters out non-speech segments)
SBO_WHISPER_VAD__ENABLED=True

# VAD method: silero, webvt, or other supported detectors
SBO_WHISPER_VAD__METHOD=silero

# Detection threshold (higher = more conservative, fewer false positives)
SBO_WHISPER_VAD__THRESHOLD=0.5

# Minimum silence duration in milliseconds before a segment break
SBO_WHISPER_VAD__MIN_SILENCE_DURATION_MS=500

# Speech padding in milliseconds added to segment boundaries
SBO_WHISPER_VAD__SPEECH_PAD_MS=250

# ---------------------------------------------------------------------------
# Faster-Whisper - Timestamp & Segmentation
#   → settings.whisper_timestamp.max_initial_timestamp
# ---------------------------------------------------------------------------

# Maximum value for the initial timestamp (in seconds)
SBO_WHISPER_TIMESTAMP__MAX_INITIAL_TIMESTAMP=1

# Force the entire audio into a single segment
SBO_WHISPER_TIMESTAMP__ONE_SEGMENT=False

# Maximum segment duration in seconds (0 = no limit)
SBO_WHISPER_TIMESTAMP__SEGMENT_DURATION=30

# ---------------------------------------------------------------------------
# Audio Preprocessing
#   → settings.audio.sample_rate
# ---------------------------------------------------------------------------

# Target audio sample rate in Hz (Whisper expects 16000)
SBO_AUDIO__SAMPLE_RATE=16000

# Duration of each audio chunk in seconds for processing
SBO_AUDIO__CHUNK_DURATION=30

# Maximum audio duration in seconds (0 = no limit)
SBO_AUDIO__MAX_DURATION=0

# Enable noise reduction preprocessing
SBO_AUDIO__NOISE_REDUCTION=True

# Sample rate for noise reduction processing
SBO_AUDIO__NOISE_REDUCTION_SAMPLE_RATE=16000

# Frame length in seconds for noise reduction analysis
SBO_AUDIO__NOISE_REDUCTION_FRAME_LENGTH=0.5

# ---------------------------------------------------------------------------
# Output
#   → settings.output.format
# ---------------------------------------------------------------------------

# Output format: json, srt, vtt, txt, etc.
SBO_OUTPUT__FORMAT=json

# Include metadata in the output (timestamps, confidence, etc.)
SBO_OUTPUT__INCLUDE_METADATA=True

# Save transcripts to disk
SBO_OUTPUT__SAVE_TRANSCRIPTS=True

# Directory where transcripts will be saved (relative or absolute path)
SBO_OUTPUT__TRANSCRIPTS_DIR=./transcripts

# Enable output formatter for post-processing
SBO_OUTPUT__USE_FORMATTER=False

# ---------------------------------------------------------------------------
# Logging
#   → settings.logging.level
# ---------------------------------------------------------------------------

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
SBO_LOGGING__LEVEL=INFO

# Log format: json, text, or other supported formats
SBO_LOGGING__FORMAT=json

# ---------------------------------------------------------------------------
# S3 / MinIO Storage
#   → settings.storage.endpoint_url
# ---------------------------------------------------------------------------

# S3-compatible storage endpoint URL
SBO_STORAGE__ENDPOINT_URL=http://localhost:9000

# Access key ID for S3/MinIO authentication
SBO_STORAGE__ACCESS_KEY_ID=changeme

# Secret access key for S3/MinIO authentication
SBO_STORAGE__SECRET_ACCESS_KEY=changeme

# Default bucket name for audio files
SBO_STORAGE__BUCKET=sbobinator

# AWS region (required by some S3-compatible services)
SBO_STORAGE__REGION=us-east-1

# Use HTTPS (True) or HTTP (False) for the storage connection
SBO_STORAGE__SECURE=False

# Maximum number of retry attempts for failed requests
SBO_STORAGE__MAX_RETRIES=3

# Connection/request timeout in seconds
SBO_STORAGE__TIMEOUT=120

# Maximum audio file size in bytes (2 GB default)
SBO_STORAGE__MAX_AUDIO_SIZE=2147483648

# Upload processed transcripts to storage
SBO_STORAGE__UPLOAD_TRANSCRIPTS=True

# Bucket name for transcript files (overrides SBO_STORAGE__BUCKET if set)
SBO_STORAGE__TRANSCRIPTS_BUCKET=sbobinator-transcripts

# Prefix/key path for transcript files in the bucket
SBO_STORAGE__TRANSCRIPTS_PREFIX=transcripts/
